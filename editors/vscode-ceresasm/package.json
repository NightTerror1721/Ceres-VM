{
  "name": "ceresasm",
  "displayName": "CeresASM",
  "description": "Language support for CASM, the assembler of the Ceres virtual machine: syntax highlighting, live diagnostics from the real ceres compiler, and a debugger.",
  "version": "0.1.0",
  "publisher": "ceresasm",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/Krampus1721/CeresASM"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "activationEvents": [
    "onLanguage:casm"
  ],
  "main": "./client/out/extension.js",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "contributes": {
    "languages": [
      {
        "id": "casm",
        "aliases": [
          "CeresASM",
          "casm"
        ],
        "extensions": [
          ".casm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "casm",
        "scopeName": "source.casm",
        "path": "./syntaxes/casm.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "ceresAsm.restartServer",
        "title": "CeresASM: Restart Language Server"
      },
      {
        "command": "ceresAsm.sendInput",
        "title": "CeresASM: Send Input to the Running Program"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "CeresASM",
      "properties": {
        "ceresAsm.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the ceres executable used to check .casm files. Leave empty to auto-detect it under the workspace (Ceres-ASM/src/ceres[.exe]) or fall back to PATH."
        },
        "ceresAsm.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VSCode and the CeresASM language server."
        }
      }
    },
    "breakpoints": [
      {
        "language": "casm"
      }
    ],
    "debuggers": [
      {
        "type": "casm",
        "label": "CeresASM",
        "languages": [
          "casm"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .casm source or .cres binary to debug.",
                "default": "${file}"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Additional .casm files to link into the same program, as 'ceres asm' would.",
                "default": []
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop before the first instruction instead of running to the first breakpoint.",
                "default": true
              },
              "memory": {
                "type": "number",
                "description": "Machine memory in bytes. Defaults to the VM's own 16 MiB.",
                "default": 16777216
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the debugger process. Defaults to the program's own folder.",
                "default": "${workspaceFolder}"
              },
              "ceresPath": {
                "type": "string",
                "description": "Path to the ceres executable. Empty uses 'ceresAsm.compilerPath', then autodetection.",
                "default": ""
              },
              "trace": {
                "type": "boolean",
                "description": "Print the debugger command line to the Debug Console.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "casm",
            "request": "launch",
            "name": "Debug the current CASM file",
            "program": "${file}",
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "CeresASM: Debug the current file",
            "description": "Assemble and debug the .casm file that is open in the editor.",
            "body": {
              "type": "casm",
              "request": "launch",
              "name": "Debug the current CASM file",
              "program": "^\"\\${file}\"",
              "stopOnEntry": true
            }
          },
          {
            "label": "CeresASM: Debug a built .cres",
            "description": "Debug an already-assembled program. Assemble it with --debug for source lines.",
            "body": {
              "type": "casm",
              "request": "launch",
              "name": "Debug program.cres",
              "program": "^\"\\${workspaceFolder}/program.cres\"",
              "stopOnEntry": true
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^20.14.0"
  }
}
