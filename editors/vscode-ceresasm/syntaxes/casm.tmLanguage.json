{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CASM",
  "scopeName": "source.casm",
  "patterns": [
    { "include": "#comments" },
    { "include": "#section-directive" },
    { "include": "#import" },
    { "include": "#const-declaration" },
    { "include": "#variable-declaration" },
    { "include": "#labels" },
    { "include": "#interrupt-declaration" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#mnemonics" },
    { "include": "#registers" },
    { "include": "#macro-parameter" },
    { "include": "#macro-label" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifier-reference" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.casm",
          "match": "//.*$"
        },
        {
          "name": "comment.block.casm",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "section-directive": {
      "name": "keyword.control.section.casm",
      "match": "@(text|rodata|data|bss)\\b"
    },
    "import": {
      "match": "\\b(import)\\b\\s*(\"[^\"]*\")?",
      "captures": {
        "1": { "name": "keyword.control.import.casm" },
        "2": { "name": "string.quoted.double.casm" }
      }
    },
    "const-declaration": {
      "match": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.control.casm" },
        "2": { "name": "variable.other.constant.casm" }
      }
    },
    "variable-declaration": {
      "match": "\\b(let)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.control.casm" },
        "2": { "name": "variable.other.casm" }
      }
    },
    "labels": {
      "comment": "Must be tried before #keywords: 'global main:' would otherwise have 'global' claimed by the bare keyword rule (same start position, first-in-list wins ties) before this compound rule ever gets a chance.",
      "match": "^\\s*(global\\s+)?(\\.?[A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
      "captures": {
        "1": { "name": "keyword.control.casm" },
        "2": { "name": "entity.name.function.label.casm" },
        "3": { "name": "punctuation.separator.label.casm" }
      }
    },
    "keywords": {
      "name": "keyword.control.casm",
      "match": "\\b(const|let|global|macro|endmacro|struct|endstruct|alias|as|align|org|assert|interrupt)\\b"
    },
    "interrupt-declaration": {
      "comment": "Contextual: only the number naming an interrupt (`interrupt UserInterrupt0: handler`) gets coloured as a constant here - a bare literal (`interrupt 16: handler`) is left to #numbers, and the handler name after ':' is left to #identifier-reference like any other label reference. Must be tried before #keywords for the same reason #labels is: both start by matching the bare word 'interrupt', and the more specific rule has to win the tie.",
      "match": "\\b(interrupt)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.control.casm" },
        "2": { "name": "variable.other.constant.casm" }
      }
    },
    "types": {
      "name": "storage.type.casm",
      "match": "\\b(u8|u16|u32|u64|i8|i16|i32|i64|f32|f64|char|bool|string|ptr|port|irq|byte|half|word|reg|freg|imm|mem|label|any|void)\\b"
    },
    "mnemonics": {
      "comment": "Case-insensitive: the real lexer resolves mnemonics via stringToMnemonic(str, /*caseSensitive=*/false). The dotted binary64 mnemonics (fadd.d, fcvt.l.d...) are tried first and matched whole, so fadd.d is one mnemonic rather than fadd plus a .d member reference - the lexer reads them whole too when written without spaces.",
      "name": "keyword.other.mnemonic.casm",
      "match": "(?i:(fcvt\\.(?:d\\.(?:s|wu|w|lu|l)|s\\.(?:d|lu|l)|(?:wu|w)\\.d|(?:lu|l)\\.(?:d|s))|(?:fadd|fsub|fmul|fdiv|fma|fsqrt|fcmp|fmin|fmax|fmod|fneg|fabs|fround|ffloor|fceil|ftrunc|fcopysign|fclass|fmov|fldr|fstr|mtf|mff)\\.d)(?![\\w.])|\\b(add64|sub64|neg64|cmp64|imull|mull|mul64|idiv64|div64|imod64|mod64|shl64|shr64|sar64|sxt64|clz64|ctz64|popcnt64|mov64|ldrd|strd|li64|nop|halt|trap|reset|int|iret|cli|sti|add|adc|sub|sbc|imulh|mulh|imul|mul|div|idiv|fmod|mod|imod|neg|imin|min|imax|max|abs|sqrt|fround|ffloor|fceil|ftrunc|fcopysign|mcpy|mset|mcmp|mscan|fma|fclass|frecipe|frsqrte|fmin|fmax|and|or|xor|not|shl|shr|sar|rol|ror|clz|ctz|popcnt|bswap|sxtb|sxth|mov|li|lui|ldrsb|ldrsh|ldrb|ldrh|ldr|strb|strh|str|lea|ifeq|ifne|ifgr|ifge|ifls|ifle|ifab|ifae|ifbl|ifbe|jnz|jnc|jns|jno|jeq|jne|jgr|jge|jls|jle|jab|jae|jbl|jbe|jmp|jp|jz|jc|js|jo|call|ret|cmp|tst|enter|leave|swap|inc|dec|clr|lc|pushf|pushm|push|popf|popm|pop|fpushm|fpopm|iitof|itof|ftoii|ftoi|mtf|mff|mtp|mfp|pgon|pgoff|invlpg|flpg|mfpf|bl|la|ldvp|stvp|ldv|stv)\\b)"
    },
    "registers": {
      "comment": "Case-insensitive: RegisterInfo::get() accepts 'R'/'r' and 'F'/'f', and the three registers with a role also answer to it - sp, fp and at, plus lr as the deprecated spelling of at. pc is not a register operand and is deliberately absent. The pairs are x0-x6 and d0-d7; x7 would be r14:r15 and the assembler refuses it, so it is left out.",
      "name": "variable.language.register.casm",
      "match": "(?i:\\b(r1[0-5]|r[0-9]|f1[0-5]|f[0-9]|x[0-6]|d[0-7]|sp|fp|at|lr)\\b)"
    },
    "macro-parameter": {
      "name": "variable.parameter.casm",
      "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
    },
    "macro-label": {
      "name": "entity.name.label.macro.casm",
      "match": "%%[A-Za-z_][A-Za-z0-9_]*"
    },
    "strings": {
      "name": "string.quoted.double.casm",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.casm",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.casm",
          "match": "\\b0[xX][0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.binary.casm",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.decimal.casm",
          "match": "-?\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "operators": {
      "name": "keyword.operator.arithmetic.casm",
      "match": "[+\\-*/]"
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.array.casm",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.separator.comma.casm",
          "match": ","
        }
      ]
    },
    "identifier-reference": {
      "comment": "Catch-all for identifiers not claimed by anything above: label references (jp/jz/.../call targets), constant and variable uses, and macro-call names. Purely lexical, so it cannot yet tell those apart (real symbol resolution is a later step) - it just keeps them from rendering as plain unstyled text.",
      "name": "variable.other.readwrite.casm",
      "match": "\\.?[A-Za-z_][A-Za-z0-9_]*"
    }
  }
}
