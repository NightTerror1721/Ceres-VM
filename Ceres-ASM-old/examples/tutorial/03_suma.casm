// Ejercicio 3: Sumadora de un dígito
//
// Objetivo: introducir la subrutina "read_command", que usaremos en el resto
// del tutorial (incluidos los dos juegos finales). Lee una línea completa de
// la terminal y devuelve solo su primer carácter en r0, descartando el resto
// de la línea (incluido el '\n'). Así el jugador puede pulsar una tecla y
// luego Intro sin que el "\n" sobrante se cuele como si fuera la siguiente
// jugada.
//
// El programa pide dos dígitos (0-9) y muestra su suma como un carácter.
// Si la suma pasa de 9 imprime "10+" en vez de un segundo dígito, para no
// complicar el ejercicio con números de dos cifras todavía (eso llega en el
// ejercicio 5).
//
// PRUEBA TÚ MISMO:
//   Cambia el programa para que reste en lugar de sumar, y para que rechace
//   (vuelva a pedir) una entrada que no sea un dígito '0'-'9'.

const TERM_STATUS = 0x00
const TERM_OUT     = 0x01
const TERM_IN      = 0x02
const SYS_CTRL     = 0xFF
const NEWLINE      = 10

@rodata
    let PROMPT1: u8[] = "Primer digito (0-9): "
    let PROMPT2: u8[] = "Segundo digito (0-9): "
    let RESULT_PREFIX: u8[] = "\nSuma = "
    let OVERFLOW_MSG: u8[] = "10+\n"

@text
global main:
    la r1, PROMPT1
    call print
    call read_command
    mov r4, r0          // r4 = primer digito (ascii)

    la r1, PROMPT2
    call print
    call read_command
    mov r5, r0          // r5 = segundo digito (ascii)

    sub r4, r4, '0'     // ascii -> valor numerico
    sub r5, r5, '0'
    add r6, r4, r5      // r6 = suma numerica (0-18)

    la r1, RESULT_PREFIX
    call print

    cmp r6, 10
    jc .single_digit    // Carry se activa si r6 < 10 (ver nota mas abajo)
    la r1, OVERFLOW_MSG
    call print
    jp .done

.single_digit:
    add r6, r6, '0'     // numero -> ascii
    outb TERM_OUT, r6
    li r7, NEWLINE
    outb TERM_OUT, r7

.done:
    li r0, 0x01
    out SYS_CTRL, r0
    ret

// read_command() -> r0 = primer byte de la siguiente linea escrita por el
// usuario. Consume toda la linea, incluido el '\n' final.
read_command:
.wait_first:
    inb r1, TERM_STATUS
    and r1, r1, 1
    jz .wait_first
    inb r0, TERM_IN     // guardamos el primer byte en r0 (valor de retorno)

.flush:
    inb r1, TERM_STATUS
    and r1, r1, 1
    jz .flush
    inb r2, TERM_IN
    cmp r2, NEWLINE
    jnz .flush
    ret

// print(r1 = puntero a string terminado en 0)
print:
    mov r3, r1
    call strlen
    mov r2, r0
    outm TERM_OUT, r3, r2
    ret

strlen:
    xor r0, r0, r0
.loop:
    ldrb r2, [r1]
    cmp r2, 0
    jz .end
    add r0, r0, 1
    add r1, r1, 1
    jp .loop
.end:
    ret
