// The Ceres calling convention.
//
// Nothing in the machine enforces any of this: `call` pushes a return address and `ret` pops it,
// and that is the whole of what the hardware knows about subroutines. What follows is a contract
// between the code you write, kept in one place so it is written the same way every time.
//
// See docs/24-Calling-Convention.md for the reasoning, the register roles and worked examples.
//
//   Arguments   r0-r3, then the caller's outgoing area at [sp + 0], [sp + 4], ...
//   Return      r0 (f0 for a float)
//   Callee-saved  r8-r11, f8-f15, fp
//   Caller-saved  r0-r7, r12, f0-f7, and the flags
//   Never touch   at (r13) - stv, and ldv into a float register, clobber it
//
// The frame, after `proc_enter`:
//
//   [fp + 8], [fp + 12], ...   arguments five and up, as the caller left them
//   [fp + 4]                   return address, pushed by `call`
//   [fp + 0]                   saved fp, pushed by `enter`
//   [sp + 0] .. [sp + N-4]     this function's own frame: outgoing args first, then
//                              saved registers and locals
//
// `sp` must not move between `proc_enter` and `proc_leave`. Everything a function needs lives in
// the frame it reserved once, which is what keeps every `[sp + Frame.field]` valid for the whole
// body - including across a `call`.

// The convention's own names for the registers that have a role in it. They are `global`, so a
// file that imports this one writes `arg0` without declaring anything; and declaring the same
// alias again is not an error, so a file that already had its own copies keeps working.
//
// Only the roles are named. r4-r7 and r8-r11 are deliberately left as numbers: what they hold is
// a decision each function makes, and a name here would be a name for nothing.

/// First argument register (`r0`). Also where the return value goes - see `ret0`.
global alias arg0 = r0
/// Second argument register (`r1`).
global alias arg1 = r1
/// Third argument register (`r2`).
global alias arg2 = r2
/// Fourth argument register (`r3`). A fifth argument and beyond go through the caller's outgoing
/// area instead - see `proc_enter`.
global alias arg3 = r3
/// The return-value register (`r0`), under the name the convention returns in.
global alias ret0 = r0

/// First float argument register (`f0`).
global alias farg0 = f0
/// Second float argument register (`f1`).
global alias farg1 = f1
/// Third float argument register (`f2`).
global alias farg2 = f2
/// Fourth float argument register (`f3`).
global alias farg3 = f3
/// The float return-value register (`f0`), under the name the convention returns in.
global alias fret0 = f0

/// Opens a frame of `$frame_size` bytes. Pass a struct's own name and the size comes from it:
///
/// ```casm
/// struct Frame
///     outgoing0: u32
///     saved_r8:  u32
///     count:     u32
/// endstruct
///
/// my_function:
///     proc_enter Frame
///     str r8, [sp + Frame.saved_r8]
///     ...
/// ```
///
/// A function that takes four arguments or fewer, keeps everything in `r0`-`r7` and calls nothing
/// needs no frame at all - just `ret`.
/// @param $frame_size imm - frame size in bytes; pass a `struct`'s own name to size it exactly.
/// @return void
global macro proc_enter $frame_size
    enter $frame_size
endmacro

/// Closes the frame and returns. `leave` restores `sp` from `fp`, so the frame size is not
/// repeated here and a function may have as many exits as it likes.
/// @return void
global macro proc_leave
    leave
    ret
endmacro
