// Fase 0 spike: echo the keyboard scancode and the mouse delta-X to the terminal.
//
// This program is a smoke test for the cooperative loop and the SDL -> device input mapping: it
// prints 'R' once (ready), then loops polling the keyboard and mouse and echoing the low byte of
// each event straight back out the terminal (which the host routes to stdout).

const TERM_OUT     = 0xFF000004
const KEY_STATUS   = 0xFF050000
const KEY_EVENT    = 0xFF050004
const MOUSE_STATUS = 0xFF060000
const MOUSE_DX     = 0xFF060004

@text
global main:
    li r0, 0x52            // 'R' - ready marker
    la r13, TERM_OUT
    strb [r13 + 0], r0

.loop:
    la r13, KEY_STATUS
    ldr r1, [r13 + 0]
    cmp r1, 0
    jz .mouse

    la r13, KEY_EVENT
    ldr r2, [r13 + 0]
    la r13, TERM_OUT
    strb [r13 + 0], r2     // echo low byte of the event (the scancode)

.mouse:
    la r13, MOUSE_STATUS
    ldr r1, [r13 + 0]
    cmp r1, 0
    jz .loop

    la r13, MOUSE_DX
    ldr r2, [r13 + 0]
    la r13, TERM_OUT
    strb [r13 + 0], r2     // echo low byte of delta X
    jp .loop
