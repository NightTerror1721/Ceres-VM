// Exercise 6: Macros and a calling convention
//
// Goal: stop repeating "strb [r13 + 0], r2" everywhere by defining macros,
// and see the wiki's calling convention (proc_enter/proc_leave) in action:
// r0 = return value, r1-r3 = arguments, r4-r9 are "callee-saved" (a
// subroutine that touches them must restore them).
//
// TRY IT YOURSELF:
//   Add a third question. Then write a "print_line $ptr" macro that calls
//   "print" and then prints a newline, so you don't repeat those two
//   instructions every time.

const TERM          = 0xFF000000  // Terminal's MMIO base
const TERM_STATUS   = 0x00        // offsets within it
const TERM_OUT      = 0x04
const TERM_IN       = 0x08
const TERM_BLOCK_ADDR = 0xF0
const TERM_BLOCK_LEN   = 0xF4
const TERM_BLOCK_CMD    = 0xF8
const BLOCK_WRITE = 2
const SYS_CTRL     = 0xFFFF0000
const NEWLINE      = 10

macro print_char $reg
    la r13, TERM
    strb [r13 + TERM_OUT], $reg
endmacro

macro proc_enter
    push r4
    push r5
    push r6
endmacro

macro proc_leave
    pop r6
    pop r5
    pop r4
    ret
endmacro

@rodata
    let Q1: u8[] = "Do you like assembly? (y/n): "
    let Q2: u8[] = "Do you prefer RISC over CISC? (y/n): "
    let YES_MSG: u8[] = "-> Great!\n"
    let NO_MSG: u8[] = "-> Well, let's keep practicing.\n"

@text
global main:
    la r1, Q1
    call ask_yes_no      // r0 = 1 if they answered 'y', 0 otherwise
    call react

    la r1, Q2
    call ask_yes_no
    call react

    li r0, 0x01
    la r13, SYS_CTRL
    strb [r13 + 0], r0
    ret

// ask_yes_no(r1 = question) -> r0 = 1 if the user answered 'y'/'Y'
ask_yes_no:
    proc_enter
    mov r4, r1           // save the pointer to the question (callee-saved)
    call print
    call read_command     // r0 = first character of the answer

    li r5, 'y'
    cmp r0, r5
    jz .yes
    li r5, 'Y'
    cmp r0, r5
    jz .yes

    li r0, 0
    proc_leave

.yes:
    li r0, 1
    proc_leave

// react(r0 = 1 or 0) -> prints YES_MSG or NO_MSG
react:
    cmp r0, 1
    jz .print_yes
    la r1, NO_MSG
    call print
    ret
.print_yes:
    la r1, YES_MSG
    call print
    ret

read_command:
    la r13, TERM
.wait_first:
    ldrb r1, [r13 + TERM_STATUS]
    and r1, r1, 1
    jz .wait_first
    ldrb r0, [r13 + TERM_IN]

.flush:
    ldrb r1, [r13 + TERM_STATUS]
    and r1, r1, 1
    jz .flush
    ldrb r2, [r13 + TERM_IN]
    cmp r2, NEWLINE
    jnz .flush
    ret

print:
    mov r3, r1
    call strlen
    mov r2, r0
    la r13, TERM
    str [r13 + TERM_BLOCK_ADDR], r3
    str [r13 + TERM_BLOCK_LEN], r2
    li r0, BLOCK_WRITE
    str [r13 + TERM_BLOCK_CMD], r0
    ret

strlen:
    xor r0, r0, r0
.loop:
    ldrb r2, [r1]
    cmp r2, 0
    jz .end
    add r0, r0, 1
    add r1, r1, 1
    jp .loop
.end:
    ret
