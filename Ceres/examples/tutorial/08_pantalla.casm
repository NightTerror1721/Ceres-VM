// Exercise 8: A real screen
//
// Goal: draw to the framebuffer instead of writing loose characters to the
// terminal. The difference matters: the terminal is a stream that only
// moves forward, and the screen is a grid that gets redrawn whole.
//
// The cycle is always the same:
//   1. Set width and height (GPU_WIDTH / GPU_HEIGHT).
//   2. GPU_CMD = 1 clears the grid and resets the write cursor to the start.
//   3. Write cells: one at a time through GPU_DATA, or all at once through
//      the block registers.
//   4. GPU_CMD = 2 shows the frame.
//
// TRY IT YOURSELF:
//   1. Change WIDTH and HEIGHT and watch how the frame changes (it draws itself).
//   2. Move the ball to another cell by changing BALL_ROW / BALL_COL.
//   3. Draw two frames in a row with the ball in different spots.

const GPU          = 0xFF030000   // Framebuffer's MMIO base
const GPU_CMD       = 0x00        // offsets within it
const GPU_WIDTH      = 0x04
const GPU_HEIGHT      = 0x08
const GPU_DATA         = 0x0C
const GPU_BLOCK_ADDR    = 0xF0
const GPU_BLOCK_LEN      = 0xF4
const GPU_BLOCK_CMD       = 0xF8
const BLOCK_WRITE = 2
const SYS_CTRL   = 0xFFFF0000

const CMD_CLEAR = 1
const CMD_SHOW  = 2

const WIDTH  = 16
const HEIGHT = 6
const CELLS  = WIDTH * HEIGHT

const BALL_ROW = 3
const BALL_COL = 9

@bss
    // The whole grid, exactly as we're about to hand it to the screen.
    let screen: u8[CELLS]

@text
global main:
    la r13, GPU

    // The screen is as big as we tell it to be, within reason: a width of
    // zero or a hundred thousand is a typo, and the device ignores it.
    li r1, WIDTH
    str [r13 + GPU_WIDTH], r1
    li r1, HEIGHT
    str [r13 + GPU_HEIGHT], r1

    call draw_frame
    call place_ball

    // Clearing resets the cursor to the start, so the dump begins at the
    // top left; without that clear, the second frame would continue where
    // the first one left off.
    li r1, CMD_CLEAR
    str [r13 + GPU_CMD], r1

    la r1, screen
    li r2, CELLS
    str [r13 + GPU_BLOCK_ADDR], r1
    str [r13 + GPU_BLOCK_LEN], r2
    li r4, BLOCK_WRITE
    str [r13 + GPU_BLOCK_CMD], r4

    li r1, CMD_SHOW
    str [r13 + GPU_CMD], r1

    li r0, 0x01
    la r13, SYS_CTRL
    strb [r13 + 0], r0
    ret

// Fills the grid: '#' on the border, ' ' inside.
draw_frame:
    la r1, screen
    xor r2, r2, r2          // row
.row:
    xor r3, r3, r3          // column
.column:
    li r4, 0x20             // ' ' by default

    cmp r2, 0
    jz .border
    cmp r2, HEIGHT - 1
    jz .border
    cmp r3, 0
    jz .border
    cmp r3, WIDTH - 1
    jz .border
    jmp .write

.border:
    li r4, 0x23             // '#'

.write:
    strb [r1], r4
    add r1, r1, 1
    add r3, r3, 1
    cmp r3, WIDTH
    jnz .column

    add r2, r2, 1
    cmp r2, HEIGHT
    jnz .row
    ret

// One specific cell: row * width + column, like any grid.
place_ball:
    la r1, screen
    li r2, BALL_ROW
    mul r2, r2, WIDTH
    add r2, r2, BALL_COL
    add r1, r1, r2
    li r3, 0x6F             // 'o'
    strb [r1], r3
    ret
