// Exercise 8: A real screen
//
// Goal: draw on the screen instead of writing loose characters to the
// terminal. The difference matters: the terminal is a stream that only
// moves forward, and the screen is a grid of cells that can be changed
// anywhere, at any time.
//
// The screen is the GPU's text plane. Its cells live in video memory (VRAM),
// one after another, row by row, and the GPU's registers say where:
//   TEXT_CELLS_BASE  the address of the first cell
//   TEXT_COLS        how many cells a row has
// A cell is 16 bits: the character in the low byte, the ink in bits 8-11 and
// the background in bits 12-15 - two of the palette's first 16 colours. A
// background of 0 is see-through.
//
// Nothing has to be "shown": the GPU draws the cells as they are at every
// frame. When the program ends, the window keeps the screen as it left it.
//
// TRY IT YOURSELF:
//   1. Change WIDTH and HEIGHT and watch how the box changes.
//   2. Move the ball to another cell by changing BALL_ROW / BALL_COL.
//   3. Give the box a background: set bits 12-15 of BLANK (try 0x1720).

const GPU             = 0xFF400000   // the GPU's MMIO base
const TEXT_COLS       = 0x204        // offsets within it
const TEXT_CELLS_BASE = 0x20C
const CURSOR_SHAPE    = 0x228
const SYS_CTRL        = 0xFFFF0000

const WIDTH  = 16
const HEIGHT = 6

const BALL_ROW = 3
const BALL_COL = 9

const BORDER = 0x0E23   // '#' in yellow (14)
const BLANK  = 0x0720   // ' ' in light grey (7)
const BALL   = 0x0C6F   // 'o' in bright red (12)

@text
global main:
    la r13, GPU
    ldr r10, [r13 + TEXT_CELLS_BASE]   // where the first cell is
    ldr r11, [r13 + TEXT_COLS]
    shl r11, r11, 1                    // bytes from one row to the next

    // The terminal's blinking cursor would sit on the box: hide it.
    xor r1, r1, r1
    str [r13 + CURSOR_SHAPE], r1

    call draw_frame
    call place_ball

    li r0, 0x01
    la r13, SYS_CTRL
    str [r13 + 0], r0
    ret

// Draws the box: BORDER round the edge, BLANK inside.
draw_frame:
    xor r2, r2, r2          // row
.row:
    xor r3, r3, r3          // column
.column:
    li r4, BLANK

    cmp r2, 0
    jz .border
    cmp r2, HEIGHT - 1
    jz .border
    cmp r3, 0
    jz .border
    cmp r3, WIDTH - 1
    jz .border
    jmp .write

.border:
    li r4, BORDER

.write:
    // The cell's address: first cell + row * bytes-per-row + column * 2.
    mul r5, r2, r11
    add r5, r5, r10
    shl r6, r3, 1
    add r5, r5, r6
    strh [r5], r4

    add r3, r3, 1
    cmp r3, WIDTH
    jnz .column

    add r2, r2, 1
    cmp r2, HEIGHT
    jnz .row
    ret

// One specific cell: row * bytes-per-row + column * 2, like any grid.
place_ball:
    li r2, BALL_ROW
    mul r2, r2, r11
    add r2, r2, r10
    add r2, r2, BALL_COL * 2
    li r3, BALL
    strh [r2], r3
    ret
