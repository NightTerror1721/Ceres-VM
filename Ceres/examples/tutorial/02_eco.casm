// Exercise 2: Keyboard echo
//
// Goal: read from the terminal's input register and write each character
// back to the output register, byte by byte, until a newline is found
// ('\n', code 10).
//
// IMPORTANT about input in Ceres:
//   The terminal is line-buffered, just like any shell: the program
//   receives nothing until the user presses Enter, and then it receives
//   the WHOLE line at once (including the trailing '\n'). That's why you
//   have to check TERM_STATUS (bit 0) before reading TERM_IN: if you read
//   it without checking, and there's nothing yet, you get a 0.
//
// TRY IT YOURSELF:
//   Run the program and type a sentence. Then modify it to convert each
//   letter to uppercase before printing it (hint: lowercase ASCII runs
//   from 'a'=97 to 'z'=122; subtracting 32 converts it to uppercase).

const TERM         = 0xFF000000   // Terminal's MMIO base
const TERM_STATUS  = 0x00         // offsets within it
const TERM_OUT     = 0x04
const TERM_IN      = 0x08
const SYS_CTRL     = 0xFFFF0000
const NEWLINE      = 10

@text
global main:
    la r13, TERM           // built once; every register below is [r13 + offset]
.wait_byte:
    ldrb r1, [r13 + TERM_STATUS]   // r1 = status bits
    and r1, r1, 1                   // we only care about the "data available" bit
    jz .wait_byte                    // if nothing is ready yet, keep waiting

    ldrb r2, [r13 + TERM_IN]         // r2 = the byte the user typed
    strb [r13 + TERM_OUT], r2         // send it right back

    cmp r2, NEWLINE
    jnz .wait_byte         // if it wasn't the end of line, keep reading

    li r0, 0x01
    la r13, SYS_CTRL
    strb [r13 + 0], r0
    ret
