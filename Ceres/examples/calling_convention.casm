// The calling convention, exercised.
//
// Four functions, each showing one part of it:
//
//   print_char   a leaf: no frame at all
//   print_u32    a frame with locals, callee-saved registers, and a call inside the body
//   factorial    recursion, which is what actually needs a callee-saved register
//   sum6         more than four arguments, read from the caller's outgoing area
//
// Prints "120" and then "21".

// The import brings the two macros and the convention's names for the registers that have a
// role in it: arg0-arg3, ret0, and the float ones. They are `global alias`, so nothing has to
// be declared here.
import "../stdlib/call.casm"

/// Terminal-output port. `outb TERM_OUT, r` writes one byte straight to stdout.
const TERM_OUT = 0x01
/// System-control port, write-only. Writing `1` shuts the machine down cleanly.
const SYS_CTRL = 0xFF
/// ASCII line feed, printed after each number.
const NEWLINE  = 10
/// ASCII `'0'`. A digit `d` prints as `DIGIT_0 + d`.
const DIGIT_0  = 48

@text

// ---------------------------------------------------------------------------------------------
/// A leaf. Takes one argument, calls nothing, and touches only a caller-saved register - so it
/// needs no frame and no prologue.
print_char:
    outb TERM_OUT, arg0
    ret

// ---------------------------------------------------------------------------------------------
/// `r8` and `r9` hold the digit buffer and how many digits are in it across the `call` to
/// `print_char`, so both have to be callee-saved ones - and therefore saved in the frame on the
/// way in.
struct PrintFrame
    saved_r8: u32
    saved_r9: u32
    digits:   u8[12]
endstruct

/// Prints an unsigned number. Digits come out least-significant first, so they are collected
/// into `PrintFrame.digits` and emitted backwards.
print_u32:
    proc_enter PrintFrame
    str [sp + PrintFrame.saved_r8], r8
    str [sp + PrintFrame.saved_r9], r9

    lea r8, [sp + PrintFrame.digits]    // where the digits go
    clr r9                              // how many so far
    mov r1, arg0

    ifne r1, 0, .collect

    li  arg0, DIGIT_0                   // zero has no digits to collect
    call print_char
    jp  .done

.collect:
    mod  r2, r1, 10
    add  r2, r2, DIGIT_0
    add  r3, r8, r9
    strb [r3 + 0], r2
    inc  r9
    div  r1, r1, 10
    ifne r1, 0, .collect

.emit:
    dec  r9
    add  r3, r8, r9
    ldrb arg0, [r3 + 0]
    call print_char
    ifne r9, 0, .emit

.done:
    ldr r8, [sp + PrintFrame.saved_r8]
    ldr r9, [sp + PrintFrame.saved_r9]
    proc_leave

// ---------------------------------------------------------------------------------------------
/// Just `r8`: the only register this body needs to survive the recursive call below.
struct FactFrame
    saved_r8: u32
endstruct

/// Recursive factorial. Recursion is where a callee-saved register earns its keep: `n` has to
/// survive the call to `factorial` itself, and every caller-saved register is fair game across
/// one - which is exactly why `r8`, not a caller-saved register, holds it here.
factorial:
    proc_enter FactFrame
    str [sp + FactFrame.saved_r8], r8

    mov  r8, arg0
    ifle r8, 1, .base

    sub  arg0, r8, 1
    call factorial                      // r8 survives; r0-r7 do not
    mul  ret0, ret0, r8
    jp   .done

.base:
    li ret0, 1

.done:
    ldr r8, [sp + FactFrame.saved_r8]
    proc_leave

// ---------------------------------------------------------------------------------------------
/// The callee's view of arguments five and up. `[fp + 8]` is the first one, immediately above
/// the return address `call` pushed and the saved `fp` that `enter` pushed on top of it.
struct Sum6Frame
    saved_fp: u32       // fp + 0
    retaddr:  u32       // fp + 4
    arg4:     u32       // fp + 8
    arg5:     u32       // fp + 12
endstruct

/// Adds six numbers. The first four arrive in `arg0`-`arg3`; the fifth and sixth arrive on the
/// stack, at `[fp + 8]`/`[fp + 12]` - see `Sum6Frame`.
sum6:
    enter                               // no locals, so no `sub sp` is needed
    add ret0, arg0, arg1
    add ret0, ret0, arg2
    add ret0, ret0, arg3
    ldr r4, [fp + Sum6Frame.arg4]
    add ret0, ret0, r4
    ldr r4, [fp + Sum6Frame.arg5]
    add ret0, ret0, r4
    leave
    ret

// ---------------------------------------------------------------------------------------------
/// `main`'s own outgoing area, at offset 0 so it lands exactly where `call` leaves it for
/// `sum6` to read back as `Sum6Frame.arg4`/`arg5`.
struct MainFrame
    outgoing0: u32      // becomes sum6's [fp + 8]
    outgoing1: u32      // becomes sum6's [fp + 12]
endstruct

/// Entry point. Prints `factorial(5)`, then the sum of six numbers - the first four in
/// registers, the last two through `MainFrame`'s outgoing area.
global main:
    proc_enter MainFrame

    li   arg0, 5
    call factorial
    call print_u32                      // factorial's result is already in r0
    li   arg0, NEWLINE
    call print_char

    li   arg0, 1
    li   arg1, 2
    li   arg2, 3
    li   arg3, 4
    li   r4, 5
    str  [sp + MainFrame.outgoing0], r4
    li   r4, 6
    str  [sp + MainFrame.outgoing1], r4
    call sum6

    call print_u32
    li   arg0, NEWLINE
    call print_char

    li  r0, 1
    out SYS_CTRL, r0
    halt
