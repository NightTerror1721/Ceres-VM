{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },

  "configurePresets": [
    {
      "name": "msvc",
      "displayName": "Visual Studio (x64)",
      "description": "El toolchain de siempre. No fija la version del generador a proposito: aqui hay Visual Studio 18 y en el CI hay 17, y CMake ya elige el mas nuevo que encuentre. Los generadores de VS 17 en adelante compilan x64 por defecto.",
      "binaryDir": "${sourceDir}/build/msvc",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "ninja",
      "displayName": "Ninja Multi-Config",
      "description": "El compilador por defecto del entorno, con ninja. Lo mas rapido para iterar.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/ninja"
    },
    {
      "name": "gcc",
      "displayName": "GCC (Ninja Multi-Config)",
      "description": "El segundo compilador, y no es redundante: cuatro cabeceras que faltaban aparecieron asi, porque MSVC las suministraba de forma transitiva.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/gcc",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    }
  ],

  "buildPresets": [
    { "name": "msvc-debug",    "configurePreset": "msvc",  "configuration": "Debug" },
    { "name": "msvc-release",  "configurePreset": "msvc",  "configuration": "Release" },
    { "name": "ninja-debug",   "configurePreset": "ninja", "configuration": "Debug" },
    { "name": "ninja-release", "configurePreset": "ninja", "configuration": "Release" },
    { "name": "gcc-debug",     "configurePreset": "gcc",   "configuration": "Debug" },
    { "name": "gcc-release",   "configurePreset": "gcc",   "configuration": "Release" }
  ],

  "testPresets": [
    {
      "name": "msvc-debug",
      "configurePreset": "msvc",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ninja-debug",
      "configurePreset": "ninja",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "gcc-debug",
      "configurePreset": "gcc",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
