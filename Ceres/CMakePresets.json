{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },

  "configurePresets": [
    {
      "name": "msvc",
      "displayName": "MSVC (Ninja Multi-Config)",
      "description": "The generator is pinned on purpose. Without it, every tool picked a different one: Visual Studio configured with plain Ninja -single-configuration, hence Debug-only- while the command line picked the Visual Studio generator. Multi-Config gives Debug and Release from a single tree, which is what VS expects from the configuration selector.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/msvc",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "ninja",
      "displayName": "Ninja Multi-Config",
      "description": "The environment's default compiler, with ninja. The fastest option for iterating.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/ninja"
    },
    {
      "name": "gcc",
      "displayName": "GCC (Ninja Multi-Config)",
      "description": "The second compiler, and it isn't redundant: four missing headers turned up this way, because MSVC was supplying them transitively.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/gcc",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    }
  ],

  "buildPresets": [
    { "name": "msvc-debug",    "configurePreset": "msvc",  "configuration": "Debug" },
    { "name": "msvc-release",  "configurePreset": "msvc",  "configuration": "Release" },
    { "name": "ninja-debug",   "configurePreset": "ninja", "configuration": "Debug" },
    { "name": "ninja-release", "configurePreset": "ninja", "configuration": "Release" },
    { "name": "gcc-debug",     "configurePreset": "gcc",   "configuration": "Debug" },
    { "name": "gcc-release",   "configurePreset": "gcc",   "configuration": "Release" }
  ],

  "testPresets": [
    {
      "name": "msvc-debug",
      "configurePreset": "msvc",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ninja-debug",
      "configurePreset": "ninja",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ninja-release",
      "configurePreset": "ninja",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "gcc-debug",
      "configurePreset": "gcc",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
