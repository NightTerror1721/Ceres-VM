// The calling convention, exercised.
//
// Four functions, each showing one part of it:
//
//   print_char   a leaf: no frame at all
//   print_u32    a frame with locals, callee-saved registers, and a call inside the body
//   factorial    recursion, which is what actually needs a callee-saved register
//   sum6         more than four arguments, read from the caller's outgoing area
//
// Prints "120" and then "21".

import "../lib/call.casm"

alias arg0 = r0
alias arg1 = r1
alias arg2 = r2
alias arg3 = r3
alias ret0 = r0

const TERM_OUT = 0x01
const SYS_CTRL = 0xFF
const NEWLINE  = 10
const DIGIT_0  = 48

@text

// ---------------------------------------------------------------------------------------------
// A leaf. It takes one argument, calls nothing, and touches only a caller-saved register, so it
// needs no frame and no prologue.
// ---------------------------------------------------------------------------------------------
print_char:
    outb TERM_OUT, arg0
    ret

// ---------------------------------------------------------------------------------------------
// Prints an unsigned number. The digits come out least-significant first, so they are collected in
// a local buffer and emitted backwards.
//
// r8 and r9 hold the buffer and the count across a `call`, so they have to be callee-saved ones -
// and therefore saved in the frame on the way in.
// ---------------------------------------------------------------------------------------------
struct PrintFrame
    saved_r8: u32
    saved_r9: u32
    digits:   u8[12]
endstruct

print_u32:
    proc_enter PrintFrame
    str r8, [sp + PrintFrame.saved_r8]
    str r9, [sp + PrintFrame.saved_r9]

    lea r8, [sp + PrintFrame.digits]    // where the digits go
    clr r9                              // how many so far
    mov r1, arg0

    ifne r1, 0, .collect

    li  arg0, DIGIT_0                   // zero has no digits to collect
    call print_char
    jp  .done

.collect:
    mod  r2, r1, 10
    add  r2, r2, DIGIT_0
    add  r3, r8, r9
    strb r2, [r3 + 0]
    inc  r9
    div  r1, r1, 10
    ifne r1, 0, .collect

.emit:
    dec  r9
    add  r3, r8, r9
    ldrb arg0, [r3 + 0]
    call print_char
    ifne r9, 0, .emit

.done:
    ldr r8, [sp + PrintFrame.saved_r8]
    ldr r9, [sp + PrintFrame.saved_r9]
    proc_return

// ---------------------------------------------------------------------------------------------
// Recursion is where a callee-saved register earns its keep: `n` has to survive the recursive
// call, and every caller-saved register is fair game across one.
// ---------------------------------------------------------------------------------------------
struct FactFrame
    saved_r8: u32
endstruct

factorial:
    proc_enter FactFrame
    str r8, [sp + FactFrame.saved_r8]

    mov  r8, arg0
    ifle r8, 1, .base

    sub  arg0, r8, 1
    call factorial                      // r8 survives; r0-r7 do not
    mul  ret0, ret0, r8
    jp   .done

.base:
    li ret0, 1

.done:
    ldr r8, [sp + FactFrame.saved_r8]
    proc_return

// ---------------------------------------------------------------------------------------------
// Arguments five and up arrive on the stack. The callee's view of them is the frame it was given:
// [fp + 8] is the first one, immediately above the return address.
// ---------------------------------------------------------------------------------------------
struct Sum6Frame
    saved_fp: u32       // fp + 0
    retaddr:  u32       // fp + 4
    arg4:     u32       // fp + 8
    arg5:     u32       // fp + 12
endstruct

sum6:
    enter                               // no locals, so no `sub sp` is needed
    add ret0, arg0, arg1
    add ret0, ret0, arg2
    add ret0, ret0, arg3
    ldr r4, [fp + Sum6Frame.arg4]
    add ret0, ret0, r4
    ldr r4, [fp + Sum6Frame.arg5]
    add ret0, ret0, r4
    leave
    ret

// ---------------------------------------------------------------------------------------------
// The caller's own frame carries the outgoing arguments, at offset 0 so that they land exactly
// where `call` leaves them for the callee.
// ---------------------------------------------------------------------------------------------
struct MainFrame
    outgoing0: u32      // becomes sum6's [fp + 8]
    outgoing1: u32      // becomes sum6's [fp + 12]
endstruct

global main:
    proc_enter MainFrame

    li   arg0, 5
    call factorial
    call print_u32                      // factorial's result is already in r0
    li   arg0, NEWLINE
    call print_char

    li   arg0, 1
    li   arg1, 2
    li   arg2, 3
    li   arg3, 4
    li   r4, 5
    str  r4, [sp + MainFrame.outgoing0]
    li   r4, 6
    str  r4, [sp + MainFrame.outgoing1]
    call sum6

    call print_u32
    li   arg0, NEWLINE
    call print_char

    li  r0, 1
    out SYS_CTRL, r0
    halt
