// Ejercicio 1: Hola, Ceres
//
// Objetivo: entender @rodata, la (load address), y cómo imprimir un string
// por el puerto de la terminal.
//
// PRUEBA TÚ MISMO:
//   1. Cambia el mensaje por tu nombre y reensambla.
//   2. Añade una segunda línea imprimiendo otro string (recuerda: cada
//      string necesita su propio "let" y una llamada a "print").

const TERM_OUT = 0x01
const SYS_CTRL = 0xFF

@rodata
    let MSG: u8[] = "Hola, Ceres!\n"

@text
global main:
    la r1, MSG
    call print
    li r0, 0x01
    out SYS_CTRL, r0
    ret

// print(r1 = puntero a string terminado en 0) -> imprime el string completo
print:
    mov r3, r1
    call strlen
    mov r2, r0
    outm TERM_OUT, r3, r2
    ret

// strlen(r1 = puntero) -> r0 = longitud sin contar el terminador
strlen:
    xor r0, r0, r0
.loop:
    ldrb r2, [r1]
    cmp r2, 0
    jz .end
    add r0, r0, 1
    add r1, r1, 1
    jp .loop
.end:
    ret
