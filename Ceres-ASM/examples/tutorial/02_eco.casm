// Ejercicio 2: Eco de teclado
//
// Objetivo: leer del puerto de entrada de la terminal (0x02) y escribir
// cada carácter de vuelta al puerto de salida (0x01), byte a byte, hasta
// encontrar un salto de línea ('\n', código 10).
//
// IMPORTANTE sobre la entrada en Ceres:
//   La terminal está almacenada por línea, igual que cualquier shell: el
//   programa no recibe nada hasta que el usuario pulsa Intro, y entonces
//   recibe TODA la línea de golpe (incluido el '\n' final). Por eso hay que
//   comprobar TERM_STATUS (bit 0) antes de leer TERM_IN: si lo lees sin
//   comprobar, y todavía no hay nada, obtienes un 0.
//
// PRUEBA TÚ MISMO:
//   Ejecuta el programa y escribe una frase. Después modifícalo para que
//   convierta cada letra a mayúscula antes de imprimirla (pista: las
//   minúsculas ascii van de 'a'=97 a 'z'=122; restar 32 las convierte a
//   mayúscula).

const TERM_STATUS = 0x00
const TERM_OUT     = 0x01
const TERM_IN      = 0x02
const SYS_CTRL     = 0xFF
const NEWLINE      = 10

@text
global main:
.wait_byte:
    inb TERM_STATUS, r1   // r1 = bits de estado
    and r1, r1, 1         // nos interesa solo el bit "hay dato"
    jz .wait_byte         // si no hay nada listo, seguimos esperando

    inb TERM_IN, r2        // r2 = el byte que escribió el usuario
    outb TERM_OUT, r2      // lo devolvemos tal cual

    cmp r2, NEWLINE
    jnz .wait_byte         // si no era el fin de línea, seguimos leyendo

    li r0, 0x01
    out SYS_CTRL, r0
    ret
