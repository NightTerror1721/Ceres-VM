// ============================================================
//  PIEDRA, PAPEL O TIJERA — contra la máquina
// ============================================================
//
// Junta todo lo visto en los ejercicios 1-7:
//   - impresión de strings (ejercicio 1)
//   - lectura de teclado con read_command (ejercicios 2-3)
//   - aritmética y saltos condicionales (ejercicios 3-4)
//   - un marcador en memoria (ejercicio 5)
//   - macros (ejercicio 6)
//   - la máquina "piensa" su jugada con el LCG (ejercicio 7)
//
// Convención interna: 0 = Piedra, 1 = Papel, 2 = Tijera.
// Regla: la jugada i vence a la jugada (i - 1 + 3) mod 3, es decir,
// "gana el que está una posición por delante en el ciclo".
//
// PRUEBA TÚ MISMO, en orden de dificultad creciente:
//   1. Añade un mensaje distinto para cada combinación ganadora
//      ("Piedra aplasta a tijera", etc.) en vez del genérico "Ganas!".
//   2. Añade un modo "mejor de 3": el primero en ganar 2 rondas gana la
//      partida y el programa termina solo.
//   3. Sustituye la regla de piedra/papel/tijera por la variante extendida
//      de 5 opciones (piedra-papel-tijera-lagarto-Spock).

const TERM_STATUS = 0x00
const TERM_OUT     = 0x01
const TERM_IN      = 0x02
const CLOCK_PORT   = 0x11
const SYS_CTRL     = 0xFF
const NEWLINE      = 10

@data
    let seed:         u32 = 0
    let score_player:  u8 = 0
    let score_cpu:     u8 = 0

@rodata
    let LCG_A: u32 = 1103515245
    let LCG_C: u32 = 12345

    let MENU: u8[] = "\n1) Piedra  2) Papel  3) Tijera  0) Salir\nTu jugada: "
    let ERR_MSG:    u8[] = "No entendi esa jugada, prueba otra vez.\n"
    let YOU_PICKED: u8[] = "Tu eliges:      "
    let CPU_PICKED: u8[] = "La maquina elige: "
    let WIN_MSG:    u8[] = "-> Ganas esta ronda!\n"
    let LOSE_MSG:   u8[] = "-> Pierdes esta ronda.\n"
    let DRAW_MSG:   u8[] = "-> Empate.\n"
    let SCORE_MSG:  u8[] = "Marcador (tu-maquina): "
    let BYE_MSG:    u8[] = "\nGracias por jugar! Marcador final -> tu: "
    let BYE_MID:    u8[] = "  maquina: "
    let NL:         u8[] = "\n"

    let NAME_PIEDRA: u8[] = "Piedra\n"
    let NAME_PAPEL:  u8[] = "Papel\n"
    let NAME_TIJERA: u8[] = "Tijera\n"

@text
global main:
    in CLOCK_PORT, r1
    stv r1, seed

.round:
    la r1, MENU
    call print
    call read_command       // r0 = primer caracter escrito

    cmp r0, '0'
    jz .bye

    cmp r0, '1'
    jz .valid
    cmp r0, '2'
    jz .valid
    cmp r0, '3'
    jz .valid

    la r1, ERR_MSG
    call print
    jp .round

.valid:
    sub r4, r0, '1'          // r4 = jugada del jugador (0,1,2)

    call next_random
    mod r5, r0, 3             // r5 = jugada de la maquina (0,1,2)

    la r1, YOU_PICKED
    call print
    mov r1, r4
    call print_choice_name

    la r1, CPU_PICKED
    call print
    mov r1, r5
    call print_choice_name

    sub r6, r4, r5           // r6 = (jugador - maquina)
    add r6, r6, 3
    mod r6, r6, 3             // 0 = empate, 1 = ganas, 2 = pierdes

    cmp r6, 0
    jz .draw
    cmp r6, 1
    jz .win

    // r6 == 2: pierdes esta ronda
    la r1, LOSE_MSG
    call print
    ldv r7, score_cpu
    add r7, r7, 1
    stv r7, score_cpu
    jp .show_score

.win:
    la r1, WIN_MSG
    call print
    ldv r7, score_player
    add r7, r7, 1
    stv r7, score_player
    jp .show_score

.draw:
    la r1, DRAW_MSG
    call print

.show_score:
    la r1, SCORE_MSG
    call print
    ldv r1, score_player
    call print_uint
    li r7, '-'
    outb TERM_OUT, r7
    ldv r1, score_cpu
    call print_uint
    la r1, NL
    call print
    jp .round

.bye:
    la r1, BYE_MSG
    call print
    ldv r1, score_player
    call print_uint
    la r1, BYE_MID
    call print
    ldv r1, score_cpu
    call print_uint
    la r1, NL
    call print
    li r0, 0x01
    out SYS_CTRL, r0
    ret

// -------------------------------------------------------------
// Subrutinas
// -------------------------------------------------------------

// print_choice_name(r1 = 0/1/2) -> imprime "Piedra"/"Papel"/"Tijera\n"
print_choice_name:
    cmp r1, 0
    jz .p_piedra
    cmp r1, 1
    jz .p_papel
    la r1, NAME_TIJERA
    call print
    ret
.p_piedra:
    la r1, NAME_PIEDRA
    call print
    ret
.p_papel:
    la r1, NAME_PAPEL
    call print
    ret

// print_uint(r1 = valor 0-99) -> imprime uno o dos digitos decimales, sin
// salto de linea. Clobbers r1, r2, r3.
print_uint:
    li r2, 10
    cmp r1, r2
    jc .pu_single          // acarreo => r1 < 10
    div r3, r1, r2          // decenas
    mod r1, r1, r2          // unidades (se reusa r1)
    add r3, r3, '0'
    outb TERM_OUT, r3
.pu_single:
    add r1, r1, '0'
    outb TERM_OUT, r1
    ret

// next_random() -> r0 = siguiente valor de la secuencia LCG
next_random:
    ldv r1, seed
    ldv r2, LCG_A
    mul r1, r1, r2
    ldv r2, LCG_C
    add r1, r1, r2
    stv r1, seed
    mov r0, r1
    ret

// read_command() -> r0 = primer byte de la siguiente linea escrita
read_command:
.wait_first:
    inb TERM_STATUS, r1
    and r1, r1, 1
    jz .wait_first
    inb TERM_IN, r0
.flush:
    inb TERM_STATUS, r1
    and r1, r1, 1
    jz .flush
    inb TERM_IN, r2
    cmp r2, NEWLINE
    jnz .flush
    ret

// print(r1 = puntero a string terminado en 0)
print:
    mov r3, r1
    call strlen
    mov r2, r0
    outm TERM_OUT, r3, r2
    ret

strlen:
    xor r0, r0, r0
.loop:
    ldrb r2, [r1]
    cmp r2, 0
    jz .end
    add r0, r0, 1
    add r1, r1, 1
    jp .loop
.end:
    ret
