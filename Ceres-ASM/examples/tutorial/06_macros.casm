// Ejercicio 6: Macros y una convención de llamada
//
// Objetivo: dejar de repetir "outb TERM_OUT, r2" por todas partes definiendo
// macros, y ver la convención de llamada de la wiki (proc_enter/proc_leave)
// en acción: r0 = valor de retorno, r1-r3 = argumentos, r4-r9 son
// "callee-saved" (una subrutina que los toca debe restaurarlos).
//
// PRUEBA TÚ MISMO:
//   Añade una tercera pregunta. Después escribe una macro "print_line $ptr"
//   que llame a "print" y luego imprima un salto de línea, para no repetir
//   esas dos instrucciones cada vez.

const TERM_STATUS = 0x00
const TERM_OUT     = 0x01
const TERM_IN      = 0x02
const SYS_CTRL     = 0xFF
const NEWLINE      = 10

macro print_char $reg
    outb TERM_OUT, $reg
endmacro

macro proc_enter
    push r4
    push r5
    push r6
endmacro

macro proc_leave
    pop r6
    pop r5
    pop r4
    ret
endmacro

@rodata
    let Q1: u8[] = "Te gusta el ensamblador? (s/n): "
    let Q2: u8[] = "Prefieres RISC sobre CISC? (s/n): "
    let YES_MSG: u8[] = "-> Genial!\n"
    let NO_MSG: u8[] = "-> Bueno, seguimos practicando.\n"

@text
global main:
    la r1, Q1
    call ask_yes_no      // r0 = 1 si contesto 's', 0 en cualquier otro caso
    call react

    la r1, Q2
    call ask_yes_no
    call react

    li r0, 0x01
    out SYS_CTRL, r0
    ret

// ask_yes_no(r1 = pregunta) -> r0 = 1 si el usuario respondio 's'/'S'
ask_yes_no:
    proc_enter
    mov r4, r1           // guardamos el puntero a la pregunta (callee-saved)
    call print
    call read_command     // r0 = primer caracter de la respuesta

    li r5, 's'
    cmp r0, r5
    jz .yes
    li r5, 'S'
    cmp r0, r5
    jz .yes

    li r0, 0
    proc_leave

.yes:
    li r0, 1
    proc_leave

// react(r0 = 1 o 0) -> imprime YES_MSG o NO_MSG
react:
    cmp r0, 1
    jz .print_yes
    la r1, NO_MSG
    call print
    ret
.print_yes:
    la r1, YES_MSG
    call print
    ret

read_command:
.wait_first:
    inb r1, TERM_STATUS
    and r1, r1, 1
    jz .wait_first
    inb r0, TERM_IN

.flush:
    inb r1, TERM_STATUS
    and r1, r1, 1
    jz .flush
    inb r2, TERM_IN
    cmp r2, NEWLINE
    jnz .flush
    ret

print:
    mov r3, r1
    call strlen
    mov r2, r0
    outm TERM_OUT, r3, r2
    ret

strlen:
    xor r0, r0, r0
.loop:
    ldrb r2, [r1]
    cmp r2, 0
    jz .end
    add r0, r0, 1
    add r1, r1, 1
    jp .loop
.end:
    ret
