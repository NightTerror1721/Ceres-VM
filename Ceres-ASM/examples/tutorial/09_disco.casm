// Ejercicio 9: Algo que sobrevive al apagado
//
// Objetivo: usar el disco (puertos 0x20-0x23). Hasta ahora todo lo que hacía un
// programa desaparecía al terminar; un disco es lo que convierte "esta partida"
// en "mis partidas".
//
// El disco se divide en sectores de 512 bytes y solo se mueve un sector cada
// vez. El ciclo es:
//   1. DISK_SECTOR = número de sector.
//   2. "inm buffer, DISK_DATA, n" lo trae a memoria, o
//      "outm DISK_DATA, buffer, n" lo lleva al disco.
//   3. DISK_STATUS dice si salió bien (bit 0) o mal (bit 1).
//   4. DISK_CMD = 1 fuerza el volcado al fichero del anfitrión.
//
// Para que el contador siga vivo entre ejecuciones hace falta un fichero detrás
// del disco:
//
//   ceres run examples/tutorial/09_disco.casm --disk partidas.img
//
// Sin --disk el disco existe igual, pero olvida todo al parar la máquina: la
// primera vez siempre dirá "1".
//
// PRUEBA TÚ MISMO:
//   1. Ejecútalo tres veces con el mismo --disk y mira crecer el contador.
//   2. Guarda además la última tecla pulsada en el byte 5 del sector.
//   3. Escribe en el sector 1 y comprueba que el sector 0 no cambia.

const TERM_OUT    = 0x01
const DISK_STATUS = 0x20
const DISK_CMD    = 0x21
const DISK_SECTOR = 0x22
const DISK_DATA   = 0x23
const SYS_CTRL    = 0xFF

const CMD_FLUSH  = 1
const ERROR_BIT  = 2
const NUESTRO    = 0x43        // 'C', para reconocer un sector nuestro
const TAM        = 8           // solo movemos los bytes que usamos

@rodata
    let VECES:  u8[] = "Veces que has ejecutado esto: "
    let FALLO:  u8[] = "El disco no responde.\n"
    let SALTO:  u8[] = "\n"

@bss
    // [0] = marca, [1] = contador. El resto queda para lo que quieras guardar.
    let registro: u8[TAM]

@text
global main:
    // Siempre el mismo sector: el 0 es tan buen sitio como cualquier otro
    // mientras el programa y quien lo lea se pongan de acuerdo.
    li r1, 0
    out DISK_SECTOR, r1

    la r1, registro
    li r2, TAM
    inm r1, DISK_DATA, r2

    inb r3, DISK_STATUS
    and r3, r3, ERROR_BIT
    cmp r3, 0
    jnz .error

    // ¿Es un sector nuestro o basura de otro programa? La marca lo dice.
    la r1, registro
    ldrb r2, [r1]
    cmp r2, NUESTRO
    jz .conocido

    li r2, NUESTRO
    strb [r1], r2
    li r2, 0
    strb [r1 + 1], r2

.conocido:
    la r1, registro
    ldrb r2, [r1 + 1]
    add r2, r2, 1
    strb [r1 + 1], r2

    // Contar de 0 a 9 es lo que cabe en un dígito; más allá, el ejercicio 3
    // enseña a partir un número en cifras.
    cmp r2, 10
    jc .imprimir
    li r2, 9

.imprimir:
    // El digito se prepara antes de llamar, y se guarda en r8: "print" usa
    // r0-r3 para lo suyo, y r0-r7 no sobreviven a una llamada. Los que si
    // sobreviven son r8-r11 (ver la convencion de llamadas).
    add r8, r2, '0'
    la r1, VECES
    call print
    outb TERM_OUT, r8
    la r1, SALTO
    call print

    // Escribir no es guardar: el volcado al fichero ocurre cuando se pide.
    la r1, registro
    li r2, TAM
    outm DISK_DATA, r1, r2
    li r1, CMD_FLUSH
    out DISK_CMD, r1

    li r0, 0x01
    out SYS_CTRL, r0
    ret

.error:
    la r1, FALLO
    call print
    li r0, 0x01
    out SYS_CTRL, r0
    ret

print:
    mov r3, r1
    call strlen
    mov r2, r0
    outm TERM_OUT, r3, r2
    ret

strlen:
    xor r0, r0, r0
.loop:
    ldrb r2, [r1]
    cmp r2, 0
    jz .end
    add r0, r0, 1
    add r1, r1, 1
    jp .loop
.end:
    ret
