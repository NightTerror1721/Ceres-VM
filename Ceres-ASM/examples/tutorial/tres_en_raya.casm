// ============================================================
//  TRES EN RAYA — dos jugadores, mismo teclado
// ============================================================
//
// Capstone final del tutorial. Reutiliza todo lo anterior y añade dos
// técnicas nuevas:
//   - un tablero como array de 9 bytes, direccionado con desplazamientos
//     calculados en tiempo de ejecución (a diferencia del ejercicio 5, aquí
//     el índice no se conoce hasta que el jugador lo escribe)
//   - una tabla de datos en @rodata (las 8 combinaciones ganadoras) que se
//     recorre con un bucle, en vez de escribir "if" a mano para cada una
//
// Convención del tablero: 0 = vacía, 1 = X, 2 = O. Las casillas se numeran
// del 1 al 9 de izquierda a derecha y de arriba a abajo, como un teléfono:
//
//     1 | 2 | 3
//    ---+---+---
//     4 | 5 | 6
//    ---+---+---
//     7 | 8 | 9
//
// Es un juego de DOS jugadores humanos (no hay IA): X y O se turnan
// escribiendo en la misma terminal.
//
// PRUEBA TÚ MISMO:
//   1. Añade un contador de partidas jugadas y muéstralo al terminar.
//   2. Cuando alguien gane, resalta la línea ganadora (imprime qué 3
//      casillas fueron) en vez de solo decir quién ganó.
//   3. El reto grande: sustituye al jugador O por la máquina, reutilizando
//      next_random del ejercicio 7 para que elija una casilla vacía al azar.

const TERM_STATUS = 0x00
const TERM_OUT     = 0x01
const TERM_IN      = 0x02
const SYS_CTRL     = 0xFF
const NEWLINE      = 10

@data
    let board: u8[9] = [0, 0, 0, 0, 0, 0, 0, 0, 0]
    let turn:  u8    = 1

@rodata
    // 8 combinaciones ganadoras: 3 filas, 3 columnas, 2 diagonales.
    let WIN_LINES: u8[24] = [0,1,2, 3,4,5, 6,7,8, 0,3,6, 1,4,7, 2,5,8, 0,4,8, 2,4,6]

    let TITLE:     u8[] = "=== Tres en raya ===\n"
    let PROMPT_X:  u8[] = "Turno de X. Elige casilla (1-9): "
    let PROMPT_O:  u8[] = "Turno de O. Elige casilla (1-9): "
    let ERR_RANGE: u8[] = "Escribe un numero de casilla entre 1 y 9.\n"
    let ERR_OCC:   u8[] = "Esa casilla ya esta ocupada.\n"
    let WIN_X_MSG: u8[] = "X ha ganado la partida!\n"
    let WIN_O_MSG: u8[] = "O ha ganado la partida!\n"
    let DRAW_MSG:  u8[] = "Tablero lleno: empate.\n"
    let SEP:       u8[] = "-----------\n"

@text
global main:
    la r1, TITLE
    call print

.turn_loop:
    call print_board

    ldv r4, turn        // r4 = jugador actual (1 = X, 2 = O)
    cmp r4, 1
    jz .prompt_x
    la r1, PROMPT_O
    jp .do_prompt
.prompt_x:
    la r1, PROMPT_X
.do_prompt:
    call print
    call read_command    // r0 = primer caracter escrito

    cmp r0, '1'
    jc .bad_range         // acarreo => r0 < '1'
    li r5, '9'
    cmp r5, r0
    jc .bad_range          // acarreo => '9' < r0

    sub r5, r0, '1'       // r5 = indice de casilla (0-8)
    la r6, board
    add r7, r6, r5
    ldrb r8, [r7 + 0]
    cmp r8, 0
    jnz .occupied

    strb r4, [r7 + 0]      // marcamos la casilla con el jugador actual

    call check_winner       // r0 = 0 (nadie), 1 (X) o 2 (O)
    cmp r0, 0
    jnz .have_winner

    call check_full
    cmp r0, 1
    jz .have_draw

    ldv r4, turn            // check_winner/check_full usan r4 como registro
                             // temporal, asi que releemos el turno actual
                             // en vez de confiar en que sobreviviera la llamada
    cmp r4, 1              // cambiamos de turno
    jz .to_o
    li r4, 1
    jp .save_turn
.to_o:
    li r4, 2
.save_turn:
    stv r4, turn
    jp .turn_loop

.bad_range:
    la r1, ERR_RANGE
    call print
    jp .turn_loop

.occupied:
    la r1, ERR_OCC
    call print
    jp .turn_loop

.have_winner:
    mov r11, r0            // print_board llama a print/strlen, que clobberan
                             // r0, asi que guardamos el ganador antes de eso
    call print_board
    cmp r11, 1
    jz .win_x
    la r1, WIN_O_MSG
    jp .announce
.win_x:
    la r1, WIN_X_MSG
.announce:
    call print
    jp .end

.have_draw:
    call print_board
    la r1, DRAW_MSG
    call print

.end:
    li r0, 0x01
    out SYS_CTRL, r0
    ret

// -------------------------------------------------------------
// Subrutinas
// -------------------------------------------------------------

// check_winner() -> r0 = 0 (sin ganador todavia), 1 o 2 (marca ganadora).
// Recorre WIN_LINES de 3 en 3 comparando las 3 casillas de cada linea.
check_winner:
    la r6, board          // r6 = base del tablero (constante en el bucle)
    la r1, WIN_LINES      // r1 = puntero a la linea actual
    li r2, 8               // r2 = lineas restantes

.line_loop:
    ldrb r3, [r1 + 0]      // indice a
    ldrb r4, [r1 + 1]      // indice b
    ldrb r5, [r1 + 2]      // indice c

    add r10, r6, r3
    ldrb r7, [r10 + 0]     // board[a]
    add r10, r6, r4
    ldrb r8, [r10 + 0]     // board[b]
    add r10, r6, r5
    ldrb r9, [r10 + 0]     // board[c]

    cmp r7, 0
    jz .next_line          // casilla vacia: esta linea no puede ganar
    cmp r7, r8
    jnz .next_line
    cmp r8, r9
    jnz .next_line

    mov r0, r7              // a, b y c coinciden y no estan vacias: ganador
    ret

.next_line:
    add r1, r1, 3
    sub r2, r2, 1
    cmp r2, 0
    jnz .line_loop

    li r0, 0
    ret

// check_full() -> r0 = 1 si las 9 casillas estan ocupadas, 0 si no.
check_full:
    la r1, board
    li r2, 9
.cf_loop:
    ldrb r3, [r1 + 0]
    cmp r3, 0
    jz .cf_not_full
    add r1, r1, 1
    sub r2, r2, 1
    cmp r2, 0
    jnz .cf_loop
    li r0, 1
    ret
.cf_not_full:
    li r0, 0
    ret

// print_board() -> imprime el tablero 3x3 actual con separadores.
print_board:
    li r1, 0
    call print_cell
    call print_bar
    li r1, 1
    call print_cell
    call print_bar
    li r1, 2
    call print_cell
    li r6, NEWLINE
    outb TERM_OUT, r6
    la r1, SEP
    call print

    li r1, 3
    call print_cell
    call print_bar
    li r1, 4
    call print_cell
    call print_bar
    li r1, 5
    call print_cell
    li r6, NEWLINE
    outb TERM_OUT, r6
    la r1, SEP
    call print

    li r1, 6
    call print_cell
    call print_bar
    li r1, 7
    call print_cell
    call print_bar
    li r1, 8
    call print_cell
    li r6, NEWLINE
    outb TERM_OUT, r6
    ret

// print_cell(r1 = indice 0-8) -> imprime " N " (vacia), " X " o " O ".
print_cell:
    la r3, board
    add r3, r3, r1
    ldrb r4, [r3 + 0]

    li r5, ' '
    outb TERM_OUT, r5

    cmp r4, 0
    jz .empty
    cmp r4, 1
    jz .is_x
    li r5, 'O'
    jp .print_it
.is_x:
    li r5, 'X'
    jp .print_it
.empty:
    add r5, r1, '1'        // muestra el numero de la casilla (indice+1)
.print_it:
    outb TERM_OUT, r5
    li r5, ' '
    outb TERM_OUT, r5
    ret

print_bar:
    li r6, '|'
    outb TERM_OUT, r6
    ret

// read_command() -> r0 = primer byte de la siguiente linea escrita.
read_command:
.wait_first:
    inb TERM_STATUS, r1
    and r1, r1, 1
    jz .wait_first
    inb TERM_IN, r0
.flush:
    inb TERM_STATUS, r1
    and r1, r1, 1
    jz .flush
    inb TERM_IN, r2
    cmp r2, NEWLINE
    jnz .flush
    ret

// print(r1 = puntero a string terminado en 0)
print:
    mov r3, r1
    call strlen
    mov r2, r0
    outm TERM_OUT, r3, r2
    ret

strlen:
    xor r0, r0, r0
.loop:
    ldrb r2, [r1]
    cmp r2, 0
    jz .end
    add r0, r0, 1
    add r1, r1, 1
    jp .loop
.end:
    ret
