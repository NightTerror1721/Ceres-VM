const OUT_WRITE = 0x01
const EXIT_CODE = 0x01
const SYS_CTRL = 0xFF

@rodata
    let HELLO_MSG: u8[17] = "Hello, CeresVM!"

@text
global main:
    la r1, HELLO_MSG
    call print
    li r0, EXIT_CODE
    out SYS_CTRL, r0
    ret

println:
.print_loop:
    ldrb r2, [r1]
    cmp r2, 0
    jz .print_end
    out OUT_WRITE, r2
    add r1, r1, 1
    jp .print_loop
.print_end:
    ret

print:
    mov r3, r1  // Save the original pointer
    call strlen
    mov r2, r0  // Length of the string
    outm OUT_WRITE, r2, r3
    ret

strlen:
    xor r0, r0, r0  // length = 0
.strlen_loop:
    ldrb r2, [r1]
    cmp r2, 0
    jz .strlen_end
    add r0, r0, 1
    add r1, r1, 1
    jp .strlen_loop
.strlen_end:
    ret